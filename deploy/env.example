# Пример переменных для продакшена на VPS.
# Скопируйте в /var/www/suicore/.env и подставьте свои значения.
# НЕ коммитьте .env в git.

# БД (Postgres на этом же VPS или удалённо)
DATABASE_URL=postgresql://USER:PASSWORD@5.42.101.54:5432/shop_db

# JWT Secret из Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

API_PORT=3001

# Supabase (авторизация и аватары)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Origin сайта (для редиректов и сборки)
VITE_APP_ORIGIN=https://suicore.space

# Цены (руб)
VITE_PRICE_DISK_OF_NATURE=950
VITE_PRICE_DEFAULT=800

# Яндекс.Карты
VITE_YANDEX_MAPS_API_KEY=your-key

# Робокасса
ROBOKASSA_LOGIN=your-login
ROBOKASSA_PASS1=pass1
ROBOKASSA_PASS2=pass2
PAYMENT_BASE_URL=https://suicore.space

# Опционально: CDEK, Apiship (если используете)
# VITE_CDEK_ACCOUNT=
# VITE_CDEK_PASSWORD=
# VITE_APISHIP_TOKEN=
