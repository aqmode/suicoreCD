# Пример переменных для продакшена на VPS.
# Скопируйте в /var/www/suicore/.env и подставьте свои значения.
# НЕ коммитьте .env в git.

# БД (Postgres на этом же VPS или удалённо)
DATABASE_URL=postgresql://USER:PASSWORD@5.42.101.54:5432/shop_db

# JWT Secret из Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

API_PORT=3001

# Supabase (авторизация и аватары)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Origin сайта (для редиректов и сборки)
VITE_APP_ORIGIN=https://suicore.space

# Цены (руб)
VITE_PRICE_DISK_OF_NATURE=950
VITE_PRICE_DEFAULT=800

# Персональная скидка для конкретных пользователей (серверная)
# Формат: id8chars1-кол_покупок,id8chars2-кол_покупок;процент_скидки
# id8chars — первые 8 символов ID пользователя (UUID)
# Пример: abcd1234-1,efgh5678-3;30  (abcd1234 — 1 покупка со скидкой 30%, efgh5678 — 3 покупки)
# PERSONAL_DISCOUNT=abcd1234-1,efgh5678-3;30

# Яндекс.Карты
VITE_YANDEX_MAPS_API_KEY=your-key

# ЮKassa (оплата)
YOOKASSA_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
PAYMENT_BASE_URL=https://suicore.space

# Опционально: CDEK, Apiship (если используете)
# VITE_CDEK_ACCOUNT=
# VITE_CDEK_PASSWORD=
# VITE_APISHIP_TOKEN=
